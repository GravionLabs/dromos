{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/BusEvent",
  "definitions": {
    "BusEvent": {
      "oneOf": [
        {
          "$ref": "#/definitions/HookIdleEvent"
        },
        {
          "$ref": "#/definitions/HookBusyEvent"
        }
      ]
    },
    "HookIdleEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "source": {
          "type": "string",
          "enum": [
            "orchestrator",
            "implementer",
            "reviewer"
          ]
        },
        "agentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "hook:idle"
        },
        "data": {
          "$ref": "#/definitions/HookEvent"
        }
      },
      "required": [
        "id",
        "at",
        "source",
        "agentId",
        "issue",
        "runId",
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "HookEvent": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "orchestrator",
            "implementer",
            "reviewer"
          ]
        },
        "cli": {
          "type": "string",
          "enum": [
            "claude",
            "copilot"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "busy"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "cli",
        "state"
      ],
      "additionalProperties": false
    },
    "HookBusyEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "source": {
          "type": "string",
          "enum": [
            "orchestrator",
            "implementer",
            "reviewer"
          ]
        },
        "agentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "hook:busy"
        },
        "data": {
          "$ref": "#/definitions/HookEvent"
        }
      },
      "required": [
        "id",
        "at",
        "source",
        "agentId",
        "issue",
        "runId",
        "type",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
