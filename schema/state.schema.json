{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "orchestrator",
              "implementer",
              "reviewer"
            ]
          },
          "client": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "busy",
              "idle",
              "exited"
            ]
          },
          "since": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "client",
          "model",
          "state",
          "since"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "issue": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "phase": {
            "type": "string",
            "enum": [
              "implementing",
              "gating",
              "reviewing",
              "approved",
              "pr_opened",
              "blocked"
            ]
          },
          "gateRounds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "lastGate": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "passed": {
                    "type": "boolean"
                  },
                  "failedSteps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "passed",
                  "failedSteps"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "worktree": {
            "type": "string"
          },
          "pr": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "issue",
          "phase",
          "gateRounds",
          "lastGate",
          "worktree",
          "pr"
        ],
        "additionalProperties": false
      }
    },
    "attentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "string"
          },
          "agentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "runId": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "agentId",
          "issue",
          "runId",
          "kind",
          "summary",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "at",
    "agents",
    "runs",
    "attentions"
  ],
  "additionalProperties": false
}
